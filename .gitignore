# Generated by xcodegen from project.yml
*.xcodeproj
xcuserdata/
DerivedData/
.build/
.swiftpm/
packages/*/.build/
packages/*/.swiftpm/

# Built by scripts/build-git-deps.sh
packages/GitKit/Vendor/

